# SentinelPM environment configuration.
# Copy to `.env` and adjust values as needed. Every variable is optional;
# the application falls back to built-in defaults when a variable is unset.

# One of: dev, test, prod
SENTINELPM_ENVIRONMENT=dev

# Logging level: DEBUG, INFO, WARNING, ERROR
SENTINELPM_LOG_LEVEL=INFO

# Global random seed for reproducibility
SENTINELPM_RANDOM_SEED=42

# Root directories, resolved relative to the project root when relative
SENTINELPM_DATA_DIR=data
SENTINELPM_ARTIFACTS_DIR=artifacts

# Optional path to a YAML config file that overrides built-in defaults
# SENTINELPM_CONFIG_PATH=configs/config.yaml

# REST API & Serving Configuration
SENTINELPM_API_PORT=8000
SENTINELPM_ACTIVE_MODEL=random_forest

# Streamlit Dashboard Configuration
SENTINELPM_API_URL=http://127.0.0.1:8000
SENTINELPM_DASHBOARD_PORT=8501

# Monitoring & Alert Thresholds
SENTINELPM_DRIFT_KS_ALPHA=0.05
SENTINELPM_DRIFT_PSI_THRESHOLD=0.25
SENTINELPM_ALERT_LATENCY_P95_MS=250.0
SENTINELPM_ALERT_ERROR_RATE_THRESHOLD=0.05

